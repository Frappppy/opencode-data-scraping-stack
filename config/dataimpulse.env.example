# DataImpulse proxy credentials — COPY to dataimpulse.local.env (gitignored), fill in, then:
#   . $HOME\.config\opencode\... no — load in your shell or point scripts at it.
# NEVER put real values in this file or any committed file.

# --- Connection (from your DataImpulse dashboard) ---
DATAIMPULSE_HOST=gw.dataimpulse.com
DATAIMPULSE_LOGIN=your_login_here
DATAIMPULSE_PASSWORD=your_password_here

# --- Ports ---
# Rotating (new IP every request):  HTTP=823  SOCKS5=824
# Sticky (IP held per port):        10000-20000
DATAIMPULSE_ROTATE_HTTP_PORT=823
DATAIMPULSE_ROTATE_SOCKS_PORT=824
DATAIMPULSE_STICKY_PORT=10000

# --- Targeting (appended to login as LOGIN__cr.CC;sessttl.MINUTES) ---
# Country code: us, gb, de, fr, au, in, br...  (see docs.dataimpulse.com/proxies/parameters)
DATAIMPULSE_COUNTRY=us
# Sticky TTL in minutes for rotating-port sessions (0 = default 30)
DATAIMPULSE_SESSION_TTL=30
